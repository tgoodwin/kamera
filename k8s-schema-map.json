{
  "mapping": {
    "apps/v1/DaemonSet": [
      {
        "name": "default",
        "object": {
          "apiVersion": "apps/v1",
          "kind": "DaemonSet",
          "metadata": {
            "name": "example-daemonset",
            "namespace": "default"
          },
          "spec": {
            "selector": {
              "matchLabels": {
                "app": "example"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "example"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "app",
                    "image": "busybox"
                  }
                ]
              }
            }
          }
        }
      }
    ],
    "apps/v1/Deployment": [
      {
        "name": "default",
        "object": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "metadata": {
            "name": "example-deployment",
            "namespace": "default"
          },
          "spec": {
            "replicas": 1,
            "selector": {
              "matchLabels": {
                "app": "example"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "example"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "app",
                    "image": "busybox"
                  }
                ]
              }
            }
          }
        }
      }
    ],
    "apps/v1/ReplicaSet": [
      {
        "name": "default",
        "object": {
          "apiVersion": "apps/v1",
          "kind": "ReplicaSet",
          "metadata": {
            "name": "example-replicaset",
            "namespace": "default"
          },
          "spec": {
            "replicas": 1,
            "selector": {
              "matchLabels": {
                "app": "example"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "example"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "app",
                    "image": "busybox"
                  }
                ]
              }
            }
          }
        }
      }
    ],
    "apps/v1/StatefulSet": [
      {
        "name": "default",
        "object": {
          "apiVersion": "apps/v1",
          "kind": "StatefulSet",
          "metadata": {
            "name": "example-statefulset",
            "namespace": "default"
          },
          "spec": {
            "serviceName": "example-service",
            "replicas": 1,
            "selector": {
              "matchLabels": {
                "app": "example"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "example"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "app",
                    "image": "busybox"
                  }
                ]
              }
            }
          }
        }
      }
    ],
    "autoscaling/v2/HorizontalPodAutoscaler": [
      {
        "name": "default",
        "object": {
          "apiVersion": "autoscaling/v2",
          "kind": "HorizontalPodAutoscaler",
          "metadata": {
            "name": "example-hpa",
            "namespace": "default"
          },
          "spec": {
            "scaleTargetRef": {
              "apiVersion": "apps/v1",
              "kind": "Deployment",
              "name": "example-deployment"
            },
            "minReplicas": 1,
            "maxReplicas": 3,
            "metrics": [
              {
                "type": "Resource",
                "resource": {
                  "name": "cpu",
                  "target": {
                    "type": "Utilization",
                    "averageUtilization": 80
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "batch/v1/CronJob": [
      {
        "name": "default",
        "object": {
          "apiVersion": "batch/v1",
          "kind": "CronJob",
          "metadata": {
            "name": "example-cronjob",
            "namespace": "default"
          },
          "spec": {
            "schedule": "*/5 * * * *",
            "jobTemplate": {
              "spec": {
                "template": {
                  "spec": {
                    "restartPolicy": "Never",
                    "containers": [
                      {
                        "name": "job",
                        "image": "busybox"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    ],
    "batch/v1/Job": [
      {
        "name": "default",
        "object": {
          "apiVersion": "batch/v1",
          "kind": "Job",
          "metadata": {
            "name": "example-job",
            "namespace": "default"
          },
          "spec": {
            "template": {
              "spec": {
                "restartPolicy": "Never",
                "containers": [
                  {
                    "name": "job",
                    "image": "busybox"
                  }
                ]
              }
            }
          }
        }
      }
    ],
    "core/v1/ConfigMap": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "ConfigMap",
          "metadata": {
            "name": "example-configmap",
            "namespace": "default"
          },
          "data": {
            "example": "value"
          }
        }
      }
    ],
    "core/v1/Endpoints": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "Endpoints",
          "metadata": {
            "name": "example-service",
            "namespace": "default"
          },
          "subsets": [
            {
              "addresses": [
                {
                  "ip": "10.0.0.1"
                }
              ],
              "ports": [
                {
                  "port": 80,
                  "protocol": "TCP"
                }
              ]
            }
          ]
        }
      }
    ],
    "core/v1/Namespace": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "Namespace",
          "metadata": {
            "name": "example"
          }
        }
      }
    ],
    "core/v1/Node": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "Node",
          "metadata": {
            "name": "example-node"
          }
        }
      }
    ],
    "core/v1/PersistentVolume": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "PersistentVolume",
          "metadata": {
            "name": "example-pv"
          },
          "spec": {
            "capacity": {
              "storage": "1Gi"
            },
            "accessModes": [
              "ReadWriteOnce"
            ],
            "persistentVolumeReclaimPolicy": "Delete",
            "storageClassName": "standard",
            "hostPath": {
              "path": "/tmp/kamera"
            }
          }
        }
      }
    ],
    "core/v1/PersistentVolumeClaim": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "PersistentVolumeClaim",
          "metadata": {
            "name": "example-pvc",
            "namespace": "default"
          },
          "spec": {
            "accessModes": [
              "ReadWriteOnce"
            ],
            "resources": {
              "requests": {
                "storage": "1Gi"
              }
            }
          }
        }
      }
    ],
    "core/v1/Pod": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "Pod",
          "metadata": {
            "name": "example-pod",
            "namespace": "default"
          },
          "spec": {
            "containers": [
              {
                "name": "app",
                "image": "busybox"
              }
            ]
          }
        }
      }
    ],
    "core/v1/Secret": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "Secret",
          "metadata": {
            "name": "example-secret",
            "namespace": "default"
          },
          "type": "Opaque",
          "stringData": {
            "username": "example",
            "password": "example"
          }
        }
      }
    ],
    "core/v1/Service": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "Service",
          "metadata": {
            "name": "example-service",
            "namespace": "default"
          },
          "spec": {
            "selector": {
              "app": "example"
            },
            "ports": [
              {
                "port": 80,
                "targetPort": 8080,
                "protocol": "TCP"
              }
            ]
          }
        }
      }
    ],
    "core/v1/ServiceAccount": [
      {
        "name": "default",
        "object": {
          "apiVersion": "v1",
          "kind": "ServiceAccount",
          "metadata": {
            "name": "example-serviceaccount",
            "namespace": "default"
          }
        }
      }
    ],
    "networking.k8s.io/v1/Ingress": [
      {
        "name": "default",
        "object": {
          "apiVersion": "networking.k8s.io/v1",
          "kind": "Ingress",
          "metadata": {
            "name": "example-ingress",
            "namespace": "default"
          },
          "spec": {
            "rules": [
              {
                "host": "example.local",
                "http": {
                  "paths": [
                    {
                      "path": "/",
                      "pathType": "Prefix",
                      "backend": {
                        "service": {
                          "name": "example-service",
                          "port": {
                            "number": 80
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ],
    "rbac.authorization.k8s.io/v1/ClusterRole": [
      {
        "name": "default",
        "object": {
          "apiVersion": "rbac.authorization.k8s.io/v1",
          "kind": "ClusterRole",
          "metadata": {
            "name": "example-clusterrole"
          },
          "rules": [
            {
              "apiGroups": [
                ""
              ],
              "resources": [
                "pods"
              ],
              "verbs": [
                "get",
                "list",
                "watch"
              ]
            }
          ]
        }
      }
    ],
    "rbac.authorization.k8s.io/v1/ClusterRoleBinding": [
      {
        "name": "default",
        "object": {
          "apiVersion": "rbac.authorization.k8s.io/v1",
          "kind": "ClusterRoleBinding",
          "metadata": {
            "name": "example-clusterrolebinding"
          },
          "subjects": [
            {
              "kind": "ServiceAccount",
              "name": "default",
              "namespace": "default"
            }
          ],
          "roleRef": {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "ClusterRole",
            "name": "example-clusterrole"
          }
        }
      }
    ],
    "rbac.authorization.k8s.io/v1/Role": [
      {
        "name": "default",
        "object": {
          "apiVersion": "rbac.authorization.k8s.io/v1",
          "kind": "Role",
          "metadata": {
            "name": "example-role",
            "namespace": "default"
          },
          "rules": [
            {
              "apiGroups": [
                ""
              ],
              "resources": [
                "pods"
              ],
              "verbs": [
                "get",
                "list",
                "watch"
              ]
            }
          ]
        }
      }
    ],
    "rbac.authorization.k8s.io/v1/RoleBinding": [
      {
        "name": "default",
        "object": {
          "apiVersion": "rbac.authorization.k8s.io/v1",
          "kind": "RoleBinding",
          "metadata": {
            "name": "example-rolebinding",
            "namespace": "default"
          },
          "subjects": [
            {
              "kind": "ServiceAccount",
              "name": "default",
              "namespace": "default"
            }
          ],
          "roleRef": {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "Role",
            "name": "example-role"
          }
        }
      }
    ]
  }
}
