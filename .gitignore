# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

bin/**

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# python crap!
*.pyc

experiments/**/*.jsonl
examples/**/*.jsonl

.vscode/**
**/.gocache/**
**/.gomodcache/**
/**/*.log

examples/chaos/**

results/**

testresults/**

*.dump
*.txt

.worktrees/
graph-experiment/
artifact-deps/
.yaks

# Dolt database files (added by bd init)
.dolt/
*.db

# Built binaries
examples/karpenter/karpenter
examples/crossplane/crossplane
examples/knative-serving/knative-serving
examples/kratix/kratix
examples/kro/kro

# === Post-paper cleanup (2026-04-25) ===

# Discarded experiment outputs
examples/kro/ablation/

# Agent-iteration scenario JSONs (intermediates) and exhaustive scenarios
# that we don't want to track. Logs of running these are in
# experiments/coverage-curves/<project>/tuning-runs*/.
examples/karpenter/scenarios/d12-tuning-v2-*.json
examples/karpenter/scenarios/d1_exhaustive.json
examples/kro/scenarios/k2b-tuning-v*.json
examples/kro/scenarios/k2b_exhaustive.json
examples/kro/scenarios/k6_exhaustive.json

# Raw exhaustive-sweep evidence dirs (deleted post-paper; preprocessed
# *-accumulated.txt files in the same parent dir are sufficient for the figures).
experiments/coverage-curves/karpenter/exhaustive-output/
experiments/coverage-curves/kro/k2b-exhaustive-output/
experiments/coverage-curves/kro/k2b-exhaustive-output-7ctrl-permute/

# Raw experimental data under experiments/coverage-curves/ (.json dumps,
# .csv metrics) — .txt and .jsonl are already covered by the global rules above.
experiments/coverage-curves/**/*.json
experiments/coverage-curves/**/*.csv

# Track only docs (.md), figures (.pdf, .png), and scripts (.py, .sh) under
# experiments/coverage-curves/. See MANIFEST.md for data provenance.
!experiments/coverage-curves/**/*.md
!experiments/coverage-curves/**/*.pdf
!experiments/coverage-curves/**/*.png
!experiments/coverage-curves/**/*.py
!experiments/coverage-curves/**/*.sh
