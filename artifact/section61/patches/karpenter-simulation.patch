@@ -106,0 +107,6 @@ func NewProvisioner(kubeClient client.Client, recorder events.Recorder,
+// SetSimulation enables simulation mode on the batcher, causing Wait()
+// to check the trigger non-blocking and return immediately.
+func (p *Provisioner) SetSimulation(enabled bool) {
+	p.batcher.SetSimulation(enabled)
+}
