diff --git a/pkg/controllers/provisioning/batcher.go b/pkg/controllers/provisioning/batcher.go
index e0fee7c9..2e783a95 100644
--- a/pkg/controllers/provisioning/batcher.go
+++ b/pkg/controllers/provisioning/batcher.go
@@ -34,2 +34,3 @@ type Batcher[T comparable] struct {
-	trigger chan struct{}
-	clk     clock.Clock
+	trigger    chan struct{}
+	clk        clock.Clock
+	simulation bool // when true, skip real-time waits
@@ -49,0 +51,6 @@ func NewBatcher[T comparable](clk clock.Clock) *Batcher[T] {
+// SetSimulation enables simulation mode where Wait() checks the trigger
+// non-blocking and returns immediately, avoiding real-time delays.
+func (b *Batcher[T]) SetSimulation(enabled bool) {
+	b.simulation = enabled
+}
+
@@ -79,0 +87,11 @@ func (b *Batcher[T]) Wait(ctx context.Context) bool {
+	if b.simulation {
+		// In simulation mode, check trigger non-blocking and return immediately.
+		// All pods are already in state; no async arrivals to wait for.
+		select {
+		case <-b.trigger:
+			return true
+		default:
+			return false
+		}
+	}
+
diff --git a/pkg/controllers/provisioning/provisioner.go b/pkg/controllers/provisioning/provisioner.go
