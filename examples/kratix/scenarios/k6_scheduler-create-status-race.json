[
  {
    "name": "k6/scheduler-create-status-race",
    "environmentState": {
      "objects": [
        {
          "apiVersion": "platform.kratix.io/v1alpha1",
          "kind": "Work",
          "metadata": {
            "name": "example-work",
            "namespace": "default"
          },
          "spec": {
            "promiseName": "example-promise",
            "resourceName": "example-resource"
          }
        },
        {
          "apiVersion": "platform.kratix.io/v1alpha1",
          "kind": "Destination",
          "metadata": {
            "name": "example-destination"
          },
          "spec": {
            "path": "example-path",
            "stateStoreRef": {
              "kind": "BucketStateStore",
              "name": "example-statestore"
            }
          }
        },
        {
          "apiVersion": "platform.kratix.io/v1alpha1",
          "kind": "BucketStateStore",
          "metadata": {
            "name": "example-statestore"
          },
          "spec": {
            "bucketName": "example-bucket",
            "endpoint": "https://example.invalid",
            "authMethod": "IAM"
          }
        }
      ]
    },
    "tuning": {
      "maxDepth": 60,
      "permuteControllers": ["WorkController", "WorkPlacementController"],
      "faultInjection": [
        {
          "reconciler": "WorkController",
          "crashAfterEffect": 1,
          "triggerOnce": true
        }
      ],
      "search": {
        "mode": "monte_carlo",
        "monteCarlo": { "seed": 600, "trials": 10 }
      }
    },
    "externalInputs": []
  }
]
