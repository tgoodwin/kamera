[
  {
    "name": "K3/staleness-replicas-lag1",
    "tuning": {
      "maxDepth": 45,
      "permuteControllers": ["ResourceGraphDefinitionController", "ApplicationController"],
      "stalenessIntervals": [
        {
          "reconciler": "ApplicationController",
          "kind": "kro.run/Application",
          "staleAt": 5,
          "catchUpAt": 8,
          "lag": 2
        }
      ]
    },
    "externalInputs": [
      {
        "id": "create-application-instance",
        "opType": "CREATE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          },
          "spec": {
            "name": "my-app",
            "image": "nginx",
            "replicas": 1,
            "ingress": {
              "enabled": true
            }
          }
        }
      },
      {
        "id": "scale-to-3-replicas",
        "opType": "UPDATE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          },
          "spec": {
            "name": "my-app",
            "image": "nginx",
            "replicas": 3,
            "ingress": {
              "enabled": true
            }
          }
        }
      }
    ]
  },
