[
  {
    "name": "K6/delete-application-with-ingress",
    "tuning": {
      "maxDepth": 50,
      "permuteControllers": ["ResourceGraphDefinitionController", "ApplicationController"]
    },
    "externalInputs": [
      {
        "id": "create-application-instance",
        "opType": "CREATE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          },
          "spec": {
            "name": "my-app",
            "image": "nginx",
            "replicas": 1,
            "ingress": {
              "enabled": true
            }
          }
        }
      },
      {
        "id": "delete-application-instance",
        "opType": "DELETE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          }
        }
      }
    ]
  },
  {
    "name": "K6/delete-application-without-ingress",
    "tuning": {
      "maxDepth": 50,
      "permuteControllers": ["ResourceGraphDefinitionController", "ApplicationController"]
    },
    "externalInputs": [
      {
        "id": "create-application-instance",
        "opType": "CREATE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          },
          "spec": {
            "name": "my-app",
            "image": "nginx",
            "replicas": 1,
            "ingress": {
              "enabled": false
            }
          }
        }
      },
      {
        "id": "delete-application-instance",
        "opType": "DELETE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          }
        }
      }
    ]
  },
  {
    "name": "K6/fault-instance-during-deletion",
    "tuning": {
      "maxDepth": 50,
      "permuteControllers": ["ResourceGraphDefinitionController", "ApplicationController"],
      "faultInjection": [
        {
          "reconciler": "ApplicationController",
          "crashAfterEffect": 1,
          "triggerOnce": true
        }
      ]
    },
    "externalInputs": [
      {
        "id": "create-application-instance",
        "opType": "CREATE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          },
          "spec": {
            "name": "my-app",
            "image": "nginx",
            "replicas": 1,
            "ingress": {
              "enabled": true
            }
          }
        }
      },
      {
        "id": "delete-application-instance",
        "opType": "DELETE",
        "object": {
          "apiVersion": "kro.run/v1alpha1",
          "kind": "Application",
          "metadata": {
            "name": "my-app-instance",
            "namespace": "default"
          }
        }
      }
    ]
  }
]
